# StockFlow — modelo de variáveis de ambiente
#
# Copie para .env e preencha. O arquivo .env está no .gitignore e nunca é versionado.
#   cp .env.example .env
#
# NENHUM valor real ou segredo de verdade entra neste arquivo.
# Gere os segredos com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Origens permitidas no CORS, separadas por vírgula.
# Nunca use "*": é incompatível com cookie de credencial e abre a API.
CORS_ORIGINS=http://localhost:5173

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Credenciais usadas pelo serviço "db" do docker-compose.yml.
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=
POSTGRES_DB=stockflow
# Banco da suíte de integração, criado no primeiro boot do container.
POSTGRES_TEST_DB=stockflow_test
# Banco da suíte E2E (Marco 7A), criado no primeiro boot do container.
POSTGRES_E2E_DB=stockflow_e2e
# Porta exposta no host. Mude se a 5432 já estiver ocupada na sua máquina.
POSTGRES_PORT=5432

# Host "localhost" no modo híbrido (banco em container, app no host).
# No modo completo (tudo em container), o compose sobrescreve o host para "db".
DATABASE_URL=postgresql://stockflow:SENHA@localhost:5432/stockflow?schema=public

# Opcional (Fase 8 / Neon PostgreSQL): conexão direta sem PgBouncer usada pelo
# Prisma CLI em `prisma migrate deploy` quando DATABASE_URL usa endpoint `-pooler`.
DIRECT_URL=

# Banco separado para a suíte de integração, que trunca tabelas entre os testes.
# Precisa ser diferente de DATABASE_URL.
DATABASE_URL_TEST=postgresql://stockflow:SENHA@localhost:5432/stockflow_test?schema=public

# Banco separado para a suíte E2E (Marco 7A). Precisa ser diferente de
# DATABASE_URL e de DATABASE_URL_TEST — a suíte recusa subir se não for.
DATABASE_URL_E2E=postgresql://stockflow:SENHA@localhost:5432/stockflow_e2e?schema=public

# ─── Autenticação (usada a partir da Fase 4) ─────────────────────────────────
# A aplicação recusa subir com segredo de menos de 32 caracteres,
# e recusa JWT_SECRET igual a JWT_REFRESH_SECRET.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Seed de desenvolvimento ─────────────────────────────────────────────────
# Senhas dos usuários fictícios criados por "npm run seed".
# Mínimo de 10 caracteres (política da §8.1). Apenas ambiente local.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_OPERATOR_PASSWORD=

# ─── Seed de demonstração pública (Fase 8 — opcional, exige ALLOW_DEMO_SEED=true) ──
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_OPERATOR_PASSWORD=

# ─── Frontend ────────────────────────────────────────────────────────────────
# Build de frontend é público: o que estiver aqui é visível para qualquer pessoa.
# Nenhum segredo entra em variável VITE_.
#
# Relativo de propósito: o dev server do Vite (em desenvolvimento) e a Pages
# Function `frontend/functions/api/[[catchall]].ts` (no Cloudflare Pages) fazem
# proxy de /api para a API, mantendo a sessão e o cookie `SameSite=Strict`
# sempre na mesma origem.
VITE_API_URL=/api/v1
# Alvo do proxy do Vite em desenvolvimento. Só muda no modo completo do compose,
# onde vira http://backend:3000.
VITE_PROXY_TARGET=http://localhost:3000
# Origem pública do backend no Render, consumida pela Cloudflare Pages Function
# (`frontend/functions/api/[[catchall]].ts`) em produção.
BACKEND_ORIGIN=http://localhost:3000

# Chave opcional de autenticação mútua entre Cloudflare Pages Functions e NestJS
# para validação segura de client IP em produção. Deixe vazia em desenvolvimento/CI.
PROXY_SECRET=
