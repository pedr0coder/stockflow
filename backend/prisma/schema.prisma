// StockFlow — modelo de dados
//
// Referência: docs/04-banco-de-dados.md
//
// Convenções aplicadas em todo o arquivo:
//   - nomes no banco em snake_case (@map / @@map); nomes na aplicação em camelCase
//   - id uuid SEM default no banco: a aplicação gera UUIDv7 (ver docs/04 §4.2).
//     Sem default, `id` é obrigatório no create e o TypeScript cobra o chamador.
//     Um default gen_random_uuid() produziria v4 e derrubaria a localidade de índice
//     que é justamente o motivo de usar v7.
//   - toda data é timestamptz; conversão para horário local só na apresentação
//   - quantidade é Decimal(14,3) e custo é Decimal(14,4). Float é proibido aqui.
//
// O que NÃO cabe neste arquivo e vive na migration SQL:
//   - CHECK constraints (o Prisma não as declara)
//   - extensão pg_trgm e índice GIN trigram em products.name

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // O generator `prisma-client` do Prisma 7 emite ESM por padrão, e o código
  // gerado usa `import.meta.url`. O backend NestJS compila para CommonJS
  // (tsconfig `module: node20` sem `"type": "module"`), e o Node 24 detecta
  // `import.meta` em um .js e carrega o arquivo como ESM, quebrando o boot com
  // `ReferenceError: exports is not defined in ES module scope`.
  //
  // Alinhar o generator ao formato de saída do pacote resolve na origem, em vez
  // de contornar com interoperabilidade.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR

  @@map("user_role")
}

enum UnitOfMeasure {
  UN
  KG
  L
  M
  BOX
  PACK

  @@map("unit_of_measure")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT

  @@map("movement_type")
}

/// O motivo existe para que o relatório responda POR QUE o estoque saiu, não
/// apenas que saiu. Texto livre não permitiria agregar perda por validade.
/// A combinação type x reason é validada no service (Fase 5).
enum MovementReason {
  // IN
  PURCHASE
  RETURN_IN
  PRODUCTION_IN
  TRANSFER_IN
  // OUT
  SALE
  CONSUMPTION
  LOSS
  EXPIRY
  TRANSFER_OUT
  // ADJUSTMENT
  INVENTORY_ADJUSTMENT
  CORRECTION

  @@map("movement_reason")
}

enum InventoryStatus {
  OPEN
  COUNTING
  PENDING_APPROVAL
  APPROVED
  CANCELLED

  @@map("inventory_status")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identidade e sessão
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id    String @id @db.Uuid
  name  String @db.VarChar(120)
  /// Normalizado para lowercase antes de gravar, para que o unique funcione
  /// como as pessoas esperam: Ana@x.com e ana@x.com são a mesma conta.
  email String @unique @db.VarChar(180)
  /// Argon2id. Nunca sai em nenhuma resposta da API (@Exclude na entidade).
  passwordHash String   @map("password_hash")
  role         UserRole @default(OPERATOR)
  /// Usuário inativo não autentica.
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  stockMovements     StockMovement[]
  inventoriesCreated Inventory[]     @relation("InventoryCreatedBy")
  inventoriesApprved Inventory[]     @relation("InventoryApprovedBy")
  inventoryItems     InventoryItem[]

  @@index([isActive, role])
  @@map("users")
}

model RefreshToken {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash SHA-256 do token, nunca o token em claro: vazamento do dump do banco
  /// não entrega sessões ativas. Ver ADR-0005.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Encadeia a rotação. Reuso de um token já substituído indica roubo.
  replacedById String?  @map("replaced_by_id") @db.Uuid
  userAgent    String?  @map("user_agent")
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cadastros
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([isActive, name])
  @@map("categories")
}

model Supplier {
  id   String  @id @db.Uuid
  name String  @db.VarChar(140)
  /// CNPJ ou CPF. Opcional porque fornecedor informal existe,
  /// mas único quando informado.
  taxId     String?  @unique @map("tax_id") @db.VarChar(18)
  email     String?  @db.VarChar(180)
  phone     String?  @db.VarChar(30)
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([name])
  @@index([isActive, name])
  @@map("suppliers")
}

model Product {
  id String @id @db.Uuid
  /// Identificador de negócio, normalizado para uppercase.
  sku         String  @unique @db.VarChar(40)
  name        String  @db.VarChar(160)
  description String?

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  supplierId String?   @map("supplier_id") @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  unit UnitOfMeasure

  /// Denormalização consciente (docs/04 §4.4). O saldo só muda por movimentação,
  /// sempre na mesma transação que grava o StockMovement, e o CHECK
  /// current_stock >= 0 na migration é a última barreira.
  currentStock Decimal @default(0) @map("current_stock") @db.Decimal(14, 3)
  minStock     Decimal @default(0) @map("min_stock") @db.Decimal(14, 3)
  unitCost     Decimal @default(0) @map("unit_cost") @db.Decimal(14, 4)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  movements      StockMovement[]
  inventoryItems InventoryItem[]

  @@index([isActive, name])
  @@index([categoryId])
  @@index([supplierId])
  /// Índice GIN trigram, criado na migration da Fase 2 (SQL escrito à mão,
  /// o Prisma não declara CHECK nem GIN no schema). Declarado aqui a partir
  /// da Fase 5 (ADR pendente de registro, D19) só para fechar o drift que o
  /// `prisma migrate diff` relatava contra este índice: sem a declaração, um
  /// `migrate dev` rodado por engano removeria o índice de busca. A
  /// declaração não gera nenhum SQL por si: o índice físico já existe.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// Movimentação de estoque — tabela imutável
// ─────────────────────────────────────────────────────────────────────────────

/// Não existe updatedAt e a API não expõe PATCH nem DELETE, por desenho.
/// Corrigir um erro significa criar um ADJUSTMENT, que também fica registrado.
/// O histórico é o registro contábil do estoque; reescrevê-lo destrói a auditoria.
model StockMovement {
  id String @id @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  type   MovementType
  reason MovementReason

  /// Magnitude, sempre > 0 (CHECK na migration). O sinal vem do `type`.
  quantity Decimal @db.Decimal(14, 3)
  /// Gravados dentro da transação, com os valores retornados pelo UPDATE
  /// condicional. Tornam o extrato auditável linha a linha sem recomputar
  /// a série inteira. Ver ADR-0003.
  stockBefore Decimal @map("stock_before") @db.Decimal(14, 3)
  stockAfter  Decimal @map("stock_after") @db.Decimal(14, 3)

  note         String? @db.VarChar(500)
  /// Nota fiscal, ordem de produção, requisição.
  referenceDoc String? @map("reference_doc") @db.VarChar(80)

  /// Restrict: o autor de uma movimentação nunca se perde.
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Preenchido quando o ajuste veio da aprovação de um inventário.
  inventoryItemId String?        @unique @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([userId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventário
// ─────────────────────────────────────────────────────────────────────────────

model Inventory {
  id   String @id @db.Uuid
  /// Ex.: INV-2026-0001
  code   String          @unique @db.VarChar(30)
  status InventoryStatus @default(OPEN)
  note   String?

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedBy   User?     @relation("InventoryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items InventoryItem[]

  @@index([status, startedAt(sort: Desc)])
  @@map("inventories")
}

model InventoryItem {
  id String @id @db.Uuid

  inventoryId String    @map("inventory_id") @db.Uuid
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Congelado no momento da CONTAGEM, não na abertura do inventário (marco
  /// 5B): a divergência compara a contagem física com o que o sistema dizia
  /// NAQUELE instante, que é a pergunta real do inventário. `null` até o item
  /// ser contado — nasce `null` na abertura, nunca na criação do item
  /// (docs/17-plano-fase-5.md §17.8.3, a normalização da migration 5B).
  expectedQty Decimal?  @map("expected_qty") @db.Decimal(14, 3)
  /// null = ainda não contado. Item não contado não entra no cálculo.
  countedQty  Decimal?  @map("counted_qty") @db.Decimal(14, 3)
  countedAt   DateTime? @map("counted_at") @db.Timestamptz(6)
  countedById String?   @map("counted_by_id") @db.Uuid
  countedBy   User?     @relation(fields: [countedById], references: [id], onDelete: SetNull)

  /// D17 (A-mín): `true` enquanto o inventário do item não foi finalizado.
  /// Nasce `true` no INSERT, então todo item criado já está sob a garantia do
  /// índice único parcial abaixo — sem protocolo de aplicação. Um trigger
  /// (`SF002`, migration 5B) o vira `false` quando o inventário chega a
  /// APPROVED ou CANCELLED; nenhum código da aplicação escreve este campo.
  ///
  /// O ÍNDICE ÚNICO PARCIAL sobre `(product_id) WHERE in_progress` NÃO está
  /// declarado aqui (PG-5, docs/17-plano-fase-5.md §17.8.5): declará-lo
  /// exigiria o preview `partialIndexes` e faria o Prisma expor `productId`
  /// como chave única do modelo, o que é enganoso (um produto tem várias
  /// linhas de `InventoryItem` ao longo do tempo). O Prisma 7.10.1 ignora um
  /// índice parcial não declarado — medido, e coberto pelas guardas PG-2
  /// (drift zero) e PG-3 (catálogo), que falham o CI antes de o índice ser
  /// removido por descuido.
  inProgress Boolean @default(true) @map("in_progress")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// A divergência (countedQty - expectedQty) NÃO é coluna: é calculada na
  /// consulta. Persistir valor derivado abre espaço para ele ficar inconsistente.
  movement StockMovement?

  @@unique([inventoryId, productId])
  @@index([productId])
  @@map("inventory_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auditoria
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @db.Uuid

  /// SetNull e não Restrict: o log sobrevive à remoção do usuário, e é por isso
  /// que actorEmail guarda uma cópia do e-mail. userId também é nulo em login
  /// falho, quando não há usuário identificado.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  actorEmail String? @map("actor_email") @db.VarChar(180)

  /// LOGIN_SUCCESS, PRODUCT_UPDATED, USER_ROLE_CHANGED, ...
  action   String  @db.VarChar(60)
  entity   String? @db.VarChar(40)
  entityId String? @map("entity_id") @db.Uuid

  /// Estado anterior e posterior, com campos sensíveis removidos por uma função
  /// única e testada. password, passwordHash, token e secret nunca chegam aqui.
  before Json?
  after  Json?

  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}
