dist/
build/
*.tsbuildinfo

# Testes e cobertura
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor, ferramentas locais e sistema operacional
