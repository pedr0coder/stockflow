# Cache de ferramentas
.eslintcache
.cache/
.vite/
.turbo/

# Prisma
# As migrations SÃO versionadas de propósito: elas são o histórico do esquema.
# Apenas artefatos locais ficam de fora.
backend/prisma/*.db
backend/prisma/*.db-journal
